{
  "name": "apex-draft",
  "productName": "Apex Draft",
  "version": "0.1.0-alpha.1",
  "description": "Draw your racing line, then watch the car drive it.",
  "author": "dnlwtsn <dwatson251@gmail.com>",
  "homepage": "https://github.com/dwatson251/apex-draft",
  "license": "MIT",
  "private": true,
  "main": "out/main/index.js",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder",
    "dist:dir": "electron-vite build && electron-builder --dir"
  },
  "dependencies": {
    "pixi.js": "^8.6.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
