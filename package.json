{
  "name": "apex-draft",
  "productName": "Apex Draft",
  "version": "0.1.0-alpha.2",
  "description": "Draw your racing line, then watch the car drive it.",
  "author": "dnlwtsn <dwatson251@gmail.com>",
  "homepage": "https://github.com/dwatson251/apex-draft",
  "license": "MIT",
  "private": true,
  "main": "out/main/index.js",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder",
    "dist:dir": "electron-vite build && electron-builder --dir",
    "build:web": "vite build --config vite.web.config.ts",
    "android:sync": "npm run build:web && cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "circuits:fetch": "node --no-warnings tools/circuits/fetch.ts",
    "circuits": "node --no-warnings tools/circuits/build.ts",
    "server:build": "node server/build.mjs",
    "server:dev": "node server/build.mjs && DATA_DIR=./server/data node server/dist/server.js",
    "server:typecheck": "tsc -p server/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.9",
    "@capacitor/filesystem": "^7.1.9",
    "@capacitor/share": "^7.0.4",
    "pixi.js": "^8.6.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "@types/node": "^22.10.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
